[Unit]
Description=Maschine MK2 web editor HTTP server
After=network.target

[Service]
ExecStart=/zynthian/venv/bin/python3 -m http.server 9000 --directory /root/Generative-Techno-ZynthianMaschine-MKII/daemon/web
Restart=on-failure
RestartSec=5
# This one serves a directory over HTTP to anything that can reach the port, and
# it needs nothing but that directory - so it gets everything that can be given
# without a rig test. ProtectSystem=full makes /usr and /boot read-only and
# leaves the clone's own directory readable, which is where the pages are.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
